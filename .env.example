# Copy to .env. Never commit .env.
ULCA_USER_ID=
ULCA_API_KEY=
# Required for Bhashini. Without it _call_bhashini() returns None immediately
# and every transcription silently falls through to Sarvam -- the primary
# provider never runs and nobody notices. Get it from the ULCA Pipeline Search
# call or the ULCA web console.
ULCA_PIPELINE_ID=
SARVAM_API_KEY=
MAPPLS_CLIENT_ID=
MAPPLS_CLIENT_SECRET=
# Bhashini/Sarvam per-provider budget in seconds. MVP_BUILD_PLAN.md: 6s.
TRANSCRIPTION_TIMEOUT_SECONDS=6
# When true, all external calls return committed fixtures. Use for offline demo.
OFFLINE_MODE=false
